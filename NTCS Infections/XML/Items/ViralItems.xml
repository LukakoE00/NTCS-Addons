  <Item name="" identifier="viralmedium" category="Equipment" description="" Tags="smallitem,medical,viraltest" cargocontaineridentifier="mediccrate" useinhealthinterface="true" scale="0.4" maxstacksize="32" maxstacksizecharacterinventory="8">
    <PreferredContainer primary="medcab" minamount="1" maxamount="2" spawnprobability="1" />
