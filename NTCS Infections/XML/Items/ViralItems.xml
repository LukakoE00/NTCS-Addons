    <InventoryIcon texture="%ModDir%/Images/InventoryIconAtlas.png" sourcerect="192,448,64,64" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Images/InGameIconAtlas.png" depth="0.8" sourcerect="154,469,51,43" />
    <Body width="60" height="50" density="20" />
    <Holdable slots="Any" msg="ItemMsgPickUpSelect" />
  </Item>

