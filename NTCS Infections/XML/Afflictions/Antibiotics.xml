<Override>
     <!-- Antibiotics -->
  <!-- Ampicillin -->
  <Affliction 
    name="" 
    description=""
    identifier="afampicillin" 
    
    healableinmedicalclinic="false" 
    targets="human" 
    type="resistance" 
    isbuff="true" 
    limbspecific="false" 
    
    showinhealthscannerthreshold="999" 
    showiconthreshold="999" 
    maxstrength="100">

    <Effect minstrength="0" maxstrength="100" strengthchange="-0.20">
      <StatusEffect target="Character" comparison="and">
        <Conditional ishuman="true" />
        <Affliction identifier="kidneydamage" strength="0.05" />
        <Affliction identifier="liverdamage" strength="0.04" />
      </StatusEffect>
    </Effect>

    <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="4,4" sheetelementsize="128,128" origin="0,0" />
