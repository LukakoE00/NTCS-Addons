<!-- Corticosteroids -->
<Affliction 
    name=""
    description=""
    identifier="afcorticosteroids" 
    
    healableinmedicalclinic="false" 
    targets="human" 
    type="resistance" 
    isbuff="true" 
    limbspecific="false" 
    
    showinhealthscannerthreshold="999" 
    showiconthreshold="999" 
    maxstrength="100">
    
    <Effect minstrength="0" maxstrength="100" strengthchange="-0.1" />
    
    <PeriodicEffect mininterval="1" maxinterval="1">
    <StatusEffect target="Character" comparison="and">
        <Conditional ishuman="true" immunity="gte 80" />
        <ReduceAffliction identifier="immunity" amount="2" />
    </StatusEffect>
    </PeriodicEffect>

