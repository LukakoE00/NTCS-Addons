 <Items>
    <!-- Bone Thresher Cells -->
    <Item name="" description="" identifier="Cells_BoneThresher" scale="0.13" category="Medical" maxstacksize="1" maxstacksizecharacterinventory="1" useinhealthinterface="True" applyTreatment="True" cargocontaineridentifier="organcrate" Tags="smallitem, medical">
        <Price baseprice="150" soldbydefault="false" />

        <Deconstruct time="10">
            <Item identifier="carbon" amount="2" />
        </Deconstruct>

        <InventoryIcon texture="%ModDir%/Images/Cells.png" sourcerect="803,817,222,197" origin="0.5,0.5" />
        <Sprite texture="%ModDir%/Images/Cells.png" sourcerect="803,817,222,197" depth="0.6" origin="0.5,0.5" />
        <Body width="25" height="25" density="20" />

        <Holdable slots="Any,RightHand,LeftHand" handle="0.5,0.5" msg="ItemMsgPickUpUse" holdangle="90">
            <!-- Cells degrade if not stored properly. -->
            <StatusEffect type="Always" target="This" condition="-0.025" interval="5" disabledeltatime="true" conditionalComparison="and">
                <Conditional hastag="neq refrigerated" targetcontainer="true" />
                <Conditional hastag="neq medicalfabricator" Locked="neq true" targetitemcomponent="ItemContainer" targetcontainer="true" />
            </StatusEffect>

            <!-- If stored properly, regenerate the cells. -->
            <StatusEffect type="OnContained" target="This" condition="0.5" interval="5" disabledeltatime="true" conditionalComparison="and">
                <Conditional condition="gte 60" />
                <Conditional hastag="refrigerated" targetcontainer="true" />
            </StatusEffect>

            <StatusEffect type="OnBroken" target="This">
                <Remove />
            </StatusEffect>
        </Holdable>

        <SkillRequirementHint identifier="medical" level="70" />
    </Item>

