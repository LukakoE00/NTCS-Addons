<?xml version="1.0" encoding="utf-8"?>
<Items>
<!-- Alien Incubator -->
<Item name="" identifier="AlienIncubator" tags="alienIncubator, refrigerated" texturescale="1.0,1.0" isshootable="true" scale="0.5" category="Machine">
  <Fabricate suitablefabricators="fabricator" requiredtime="30" requiresrecipe="true">
    <RequiredSkill identifier="medical" level="40" />
    <RequiredItem identifier="fpgacircuit" />
    <RequiredItem identifier="GraftingCure" />
    <RequiredItem identifier="plastic" />
    <RequiredItem identifier="steel" amount="1" />
    <RequiredItem identifier="alienpowercell" amount="1" />
  </Fabricate>

  <Deconstruct time="20">
    <Item identifier="fpgacircuit" />
    <Item identifier="steel" />
  </Deconstruct>

  <!-- Grafting of cells into organs goes by removing the existing items and spawning a new one in their place by means of a Deconstructor component. -->
  <Deconstructor canbeselected="true" showoutput="false" powerconsumption="300.0" deconstructitemssimultaneously="true" msg="ItemMsgInteractSelect" activatebuttontext="Incubate" infotext="Incubate the organ to be overtaken by alien DNA." infoareawidth="0.36">
    <GuiFrame relativesize="0.25,0.3" style="ItemUI" anchor="Left" />
    <sound file="Content/Items/Fabricators/Fabricator.ogg" type="OnActive" range="1000.0" loop="true" />
    <poweronsound file="Content/Items/PowerOnLight3.ogg" range="600" loop="false" />
    <StatusEffect type="InWater" target="This" condition="-0.5" />
  </Deconstructor>

  <ItemContainer capacity="2" maxstacksize="1" canbeselected="true" hideitems="true" hudpos="0.5, 0.4" slotsperrow="5" uilabel="" allowuioverlap="true">
    <Containable items="grafting_StemCells, graftingcelltype, liver, lung, heart" />
  </ItemContainer>
  <ItemContainer capacity="2" maxstacksize="1" canbeselected="true" hideitems="true" hudpos="0.5, 0.8" slotsperrow="3" uilabel="" allowuioverlap="true">
    <Containable items="graftingcelltype, graftingorgantype" />
  </ItemContainer>

  <sprite texture="Content/Map/Outposts/Art/MedicalItemResearch.png" sourcerect="0,566,205,286" depth="0.79" premultiplyalpha="false" origin="0.5,0.5" />
  <Body width="205" height="286" density="40" />

  <Holdable slots="LeftHand+RightHand" canbeselected="true" selectkey="Select" canbepicked="true" attachable="true" attachedbydefault="true" pickkey="Use" pickingtime="5" holdpos="0,0" holdangle="0" aimable="true" aimpos="0,0" aimangle="0" limitedattachable="false" origin="0.5,0.5" msg="ItemMsgDetachWrench">
    <RequiredItem items="wrench" type="Equipped" />
    <StatusEffect type="OnActive" target="This" interval="1">
      <DropContainedItems />
    </StatusEffect>
  </Holdable>

  <ConnectionPanel selectkey="Action" canbeselected="true" hudpriority="10" msg="ItemMsgRewireScrewdriver">
    <GuiFrame relativesize="0.2,0.32" minsize="400,350" maxsize="480,420" anchor="Center" style="ConnectionPanel" />
    <RequiredSkill identifier="electrical" level="40" />
    <StatusEffect type="OnFailure" target="Character" targetlimbs="LeftHand,RightHand" AllowWhenBroken="true">
      <Sound file="Content/Sounds/Damage/Electrocution1.ogg" range="1000" />
      <Explosion range="100.0" force="1.0" flames="false" shockwave="false" sparks="true" underwaterbubble="false" />
      <Affliction identifier="stun" strength="4" />
      <Affliction identifier="burn" strength="5" />
    </StatusEffect>
    <RequiredItem items="screwdriver" type="Equipped" />
    <input name="power_in" displayname="connection.powerin" />
    <output name="condition_out" displayname="connection.conditionout" />
  </ConnectionPanel>

  <Repairable selectkey="Action" header="electricalrepairsheader" deteriorationspeed="0.0" canbeselected="true" RepairThreshold="80" fixDurationHighSkill="5" fixDurationLowSkill="25" msg="ItemMsgRepairScrewdriver" hudpriority="10">
    <GuiFrame relativesize="0.2,0.16" minsize="400,180" maxsize="480,280" anchor="Center" relativeoffset="0.0,0.27" style="ItemUI" />
    <RequiredSkill identifier="electrical" level="50" />
    <RequiredItem items="screwdriver" type="Equipped" />
    <ParticleEmitter particle="spark" particleamount="5" emitinterval="2" particlespersecond="5" anglemax="360" distancemax="30" velocitymin="100" velocitymax="500" scalemin="0.5" scalemax="1" mincondition="0.0" maxcondition="15.0" />
  </Repairable>
</Item>

<!-- Alien Scalpel -->
<Item name="" identifier="AlienScalpel" category="Equipment" cargocontaineridentifier="mediccrate" Tags="smallitem,medical,surgery,surgerytool" description="" useinhealthinterface="True" applyTreatment="True" scale="0.250">
    <PreferredContainer primary="toxcontainer" spawnprobability="0.1" />
    <PreferredContainer primary="locker" />

    <Price baseprice="35" soldbydefault="true">
      <Price storeidentifier="merchantmedical" sold="true" multiplier="0.9" minavailable="1" />
    </Price>

    <Fabricate suitablefabricators="fabricator">
      <RequiredSkill identifier="medical" level="20" />
      <RequiredSkill identifier="mechanical" level="15" />
      <RequiredItem identifier="fulgurium" mincondition="1" usecondition="true" />
      <RequiredItem identifier="zinc" mincondition="1" usecondition="true" />
    </Fabricate>

    <Deconstruct />

    <InventoryIcon texture="%ModDir%/Images/alienScalpel.png" sourcerect="0,0,125,15" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Images/alienScalpel.png" sourcerect="0,0,125,15" depth="0.55" origin="0.5,0.5" />
    <Body width="65" height="15" density="50" />

    <MeleeWeapon slots="Any,RightHand,LeftHand" aimpos="40,5" handle1="-7,-5" holdangle="60" reload="1.0">
      <StatusEffect type="OnUse" target="Limb" comparison="and" />
    </MeleeWeapon>

    <SkillRequirementHint identifier="medical" level="30" />
  </Item>

  <!-- DNA Ligation Enhancer -->
  <Item name="" identifier="GraftingCure" category="Medical" maxstacksize="32" maxstacksizecharacterinventory="8" cargocontaineridentifier="mediccrate" Tags="smallitem,chem,medical,syringe" description="Used to support the combination of human and alien DNA. Humans are prone to overdose." useinhealthinterface="true" scale="0.5" impactsoundtag="impact_metal_light" RequireAimToUse="True">
    <PreferredContainer primary="medcab" secondary="medcontainer" />
    <PreferredContainer secondary="wreckmedcab,abandonedmedcab,piratemedcab" minamount="1" maxamount="3" spawnprobability="0.33" />

    <Price baseprice="150" sold="false" minleveldifficulty="65">
      <Price storeidentifier="merchanthusk" minavailable="2" maxavailable="4" sold="true">
        <Reputation faction="huskcult" min="35" />
      </Price>
    </Price>

    <Fabricate suitablefabricators="medicalfabricator" requiredtime="30" amount="4" requiresrecipe="true">
      <RequiredSkill identifier="medical" level="40" />
      <RequiredItem identifier="fulgurium" amount="1" />
      <RequiredItem identifier="stabilozine" amount="2" />
    </Fabricate>

    <Deconstruct time="20">
      <Item identifier="opium" />
    </Deconstruct>

    <InventoryIcon texture="%ModDir%/Images/AegisMedicine.png" sourcerect="0,0,37,69" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Images/AegisMedicine.png" sourcerect="0,0,37,69" depth="0.6" origin="0.5,0.5" />
    <Body width="35" height="65" density="10.2" waterdragcoefficient="1" />
    
    <MeleeWeapon canBeCombined="true" removeOnCombined="true" slots="Any,RightHand,LeftHand" aimpos="40,5" handle1="0,0" holdangle="220" reload="1.0" msg="ItemMsgPickUpSelect" HitOnlyCharacters="true">
      <StatusEffect type="OnSuccess" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Sound file="Content/Items/Medical/Syringe.ogg" range="500" />
      </StatusEffect>
      <StatusEffect type="OnFailure" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Sound file="Content/Items/Medical/Syringe.ogg" range="500" />
      </StatusEffect>
    </MeleeWeapon>

    <Projectile characterusable="false" launchimpulse="18.0" sticktocharacters="true" launchrotation="-90" inheritstatuseffectsfrom="MeleeWeapon" inheritrequiredskillsfrom="MeleeWeapon" />
    <SkillRequirementHint identifier="medical" level="50" />
  </Item>

  <!-- DNA Splicer -->
  <Item name="" identifier="DNASplicer" category="Medical" maxstacksize="32" maxstacksizecharacterinventory="8" cargocontaineridentifier="mediccrate" Tags="smallitem,chem,medical,syringe" description="Used to splice human and alien DNA to safely remove alien DNA that is thoroughly rooted into a person." useinhealthinterface="true" scale="0.5" impactsoundtag="impact_metal_light" RequireAimToUse="True">
    <PreferredContainer primary="medcab" secondary="medcontainer" />

    <Price baseprice="500" minavailable="0" />

    <Fabricate suitablefabricators="medicalfabricator" requiredtime="5" amount="1">
      <RequiredSkill identifier="medical" level="30" />
      <RequiredItem identifier="antibiotics" amount="1" />
      <RequiredItem identifier="stabilozine" amount="1" />
    </Fabricate>

    <Deconstruct time="20">
      <Item identifier="opium" />
    </Deconstruct>

    <InventoryIcon texture="%ModDir%/Images/AegisMedicine.png" sourcerect="37,0,37,69" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Images/AegisMedicine.png" sourcerect="37,0,37,69" depth="0.6" origin="0.5,0.5" />
    <Body width="35" height="65" density="10.2" waterdragcoefficient="1" />
    
    <MeleeWeapon canBeCombined="true" removeOnCombined="true" slots="Any,RightHand,LeftHand" aimpos="40,5" handle1="0,0" holdangle="220" reload="1.0" msg="ItemMsgPickUpSelect" HitOnlyCharacters="true">
      <StatusEffect type="OnSuccess" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Sound file="Content/Items/Medical/Syringe.ogg" range="500" />
      </StatusEffect>
      <StatusEffect type="OnFailure" target="UseTarget">
        <Conditional entitytype="eq Character" />
        <Sound file="Content/Items/Medical/Syringe.ogg" range="500" />
      </StatusEffect>
    </MeleeWeapon>

    <Projectile characterusable="false" launchimpulse="18.0" sticktocharacters="true" launchrotation="-90" inheritstatuseffectsfrom="MeleeWeapon" inheritrequiredskillsfrom="MeleeWeapon" />
    <SkillRequirementHint identifier="medical" level="50" />
  </Item>

  <!-- Stem Cells -->
  <Item name="" identifier="grafting_StemCells" description="" category="Medical" scale="0.1" maxstacksize="1" maxstacksizecharacterinventory="1" useinhealthinterface="False" applyTreatment="True" cargocontaineridentifier="organcrate" Tags="smallitem, medical">
    <InventoryIcon texture="%ModDir%/Images/petriDish.png" sourcerect="0,0,130,120" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Images/petriDish.png" sourcerect="0,0,130,120" depth="0.6" origin="0.5,0.5" />
    <Body width="48" height="48" density="20" />

    <Fabricate suitablefabricators="medicalfabricator" requiredtime="20">
      <RequiredSkill identifier="medical" level="60" />
      <RequiredItem tag="bloodbag" />
      <RequiredItem identifier="pomegrenadeextract" />
      <RequiredItem identifier="plastic" />
    </Fabricate>

    <!-- Todo: Not do it this way. Future me, get on it! -->
    <Deconstruct time="120" requireddeconstructor="AlienIncubator">
      <Item identifier="Cells_BoneThresher" requiredotheritem="Cells_BoneThresher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_BoneThresher" requiredotheritem="Cells_BoneThresher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Charybdis" requiredotheritem="Cells_Charybdis" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Charybdis" requiredotheritem="Cells_Charybdis" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Endworm" requiredotheritem="Cells_Endworm" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Endworm" requiredotheritem="Cells_Endworm" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Hammerhead" requiredotheritem="Cells_Hammerhead" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Hammerhead" requiredotheritem="Cells_Hammerhead" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Husk" requiredotheritem="Cells_Husk" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Husk" requiredotheritem="Cells_Husk" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Moloch" requiredotheritem="Cells_Moloch" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Moloch" requiredotheritem="Cells_Moloch" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Mudraptor" requiredotheritem="Cells_Mudraptor" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Mudraptor" requiredotheritem="Cells_Mudraptor" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_TigerThresher" requiredotheritem="Cells_TigerThresher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_TigerThresher" requiredotheritem="Cells_TigerThresher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Broodmother" requiredotheritem="Cells_Broodmother" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Broodmother" requiredotheritem="Cells_Broodmother" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Latcher" requiredotheritem="Cells_Latcher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Latcher" requiredotheritem="Cells_Latcher" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Mantis" requiredotheritem="Cells_Mantis" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Mantis" requiredotheritem="Cells_Mantis" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Viperling" requiredotheritem="Cells_Viperling" mincondition="0.1" usecondition="true" />
      <Item identifier="Cells_Viperling" requiredotheritem="Cells_Viperling" mincondition="0.1" usecondition="true" />
    </Deconstruct>

    <Price baseprice="500" soldbydefault="false" />

    <Holdable slots="Any,RightHand,LeftHand" handle="0.5,0.5" msg="ItemMsgPickUpUse" holdangle="90">
      <!-- Cells degrade if not stored properly. -->
      <StatusEffect type="Always" target="This" condition="-0.025" interval="5" disabledeltatime="true" conditionalComparison="and">
          <Conditional hastag="neq refrigerated" targetcontainer="true" />
          <Conditional hastag="neq medicalfabricator" Locked="neq true" targetitemcomponent="ItemContainer" targetcontainer="true" />
      </StatusEffect>

      <!-- If stored properly, regenerate the cells. -->
      <StatusEffect type="OnContained" target="This" condition="0.5" interval="5" disabledeltatime="true" conditionalComparison="and">
          <Conditional condition="gte 60" />
          <Conditional hastag="refrigerated" targetcontainer="true" />
      </StatusEffect>

      <StatusEffect type="OnBroken" target="This">
          <Remove />
      </StatusEffect>
    </Holdable>
