    <Item name="Broodmother Liver" identifier="broodmotherLiverAegis" description="The removed liver of a Crawler Broodmother, oozing with acids" category="Medical" scale="0.3" maxstacksize="1" maxstacksizecharacterinventory="1" useinhealthinterface="True" applyTreatment="True" cargocontaineridentifier="organcrate" Tags="smallitem, medical">
