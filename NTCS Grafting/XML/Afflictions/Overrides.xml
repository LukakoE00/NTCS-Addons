        <TriggerAnimation Type="SwimSlow" path="%ModDir:3744761298%\Characters\Human\Animations\HumanProneSwimSlow.xml" priority="10" ExpectedSpecies="Human" />
        <TriggerAnimation Type="SwimFast" path="%ModDir:3744761298%\Characters\Human\Animations\HumanProneSwimFast.xml" priority="10" ExpectedSpecies="Human" />
        </StatusEffect>
    </Effect>

    <icon texture="Content/UI/MainIconsAtlas.png" sourcerect="128,640,128,128" color="195,177,60,255" origin="0,0"/>
