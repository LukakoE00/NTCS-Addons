<?xml version="1.0" encoding="utf-8"?>
<Overrides>
  <Afflictions>
    <!-- Cyberarm: Converts the arm into a CyberArm. -->
    <Affliction 
      name="" 
      description="" 
      identifier="ntc_cyberarm"

      healableinmedicalclinic="false" 
      targets="human"
      limbspecific="true" 
      type="resistance" 
      isbuff="true" 

      showinhealthscannerthreshold="999"
      showiconthreshold="0"
      maxstrength="100"

      iconcolors="76,102,145,255;76,102,145,255">
      
      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="5,0" sheetelementsize="128,128" origin="0,0" />
      
      <Effect minstrength="0" maxstrength="100">
        <StatValue stattype="RangedSpreadReduction" value="0.3" />
      </Effect>
    </Affliction>

    <!-- Arm Speed: Invisible. Applies bonuses from having one or both CyberArms. -->
    <Affliction 
      name="Arm Speed" 
      description="" 
      identifier="ntc_armspeed" 

      healableinmedicalclinic="false" 
      targets="human" 
      type="resistance" 
      isbuff="true" 
      limbspecific="true" 

      showinhealthscannerthreshold="999" 
      showiconthreshold="999" 
      maxstrength="200" 
      
      iconcolors="76,102,145,255;76,102,145,255">

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="7,0" sheetelementsize="128,128" origin="0,0" />
      
      <Effect minstrength="0" maxstrength="200" strengthchange="0">
        <StatValue stattype="SwimmingSpeed" minvalue="0" maxvalue="0.5" />
        <StatValue stattype="MeleeAttackMultiplier" minvalue="0" maxvalue="1" />
      </Effect>
    </Affliction>

    <!-- Cyberleg: Converts the leg into a CyberLeg. -->
    <Affliction 
      name="" 
      description="" 
      identifier="ntc_cyberleg"

      healableinmedicalclinic="false"
      limbspecific="true"
      targets="human"
      type="resistance" 
      isbuff="true" 

      showinhealthscannerthreshold="999" 
      showiconthreshold="0" 
      maxstrength="100" 

      iconcolors="76,102,145,255;76,102,145,255">
      
      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="6,0" sheetelementsize="128,128" origin="0,0" />
    </Affliction>

    <!-- Leg Speed: Invisible. Applies bonuses from having one or both CyberLegs. -->
    <Affliction 
      name="Leg Speed"
      description=""
      identifier="ntc_legspeed"

      healableinmedicalclinic="false"
      limbspecific="true" 
      targets="human" 
      type="resistance" 
      isbuff="true" 
      
      showinhealthscannerthreshold="999"
      showiconthreshold="999" 
      maxstrength="200" 

      iconcolors="76,102,145,255;76,102,145,255">
      
      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="7,0" sheetelementsize="128,128" origin="0,0" />
      
      <Effect minstrength="0" maxstrength="200">
        <Statvalue stattype="WalkingSpeed" minvalue="0" maxvalue="0.5" />
      </Effect>
    </Affliction>

    <!-- Artificial Limb: Invisible. Affliction that converts all regular damage taken into Cybernetic Specific afflictions. -->
    <Affliction 
      name="" 
      description="" 
      identifier="ntc_cyberlimb"

      healableinmedicalclinic="false" 
      targets="human"
      limbspecific="true"
      isbuff="true" 

      showinhealthscannerthreshold="999"
      showiconthreshold="999"
      maxstrength="100"

      iconcolors="76,102,145,255;76,102,145,255">

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="0,0" sheetelementsize="128,128" origin="0,0" />
    </Affliction>

    <!-- Waterproof: Prevents damage to Cyberlimbs while in water. -->
    <Affliction 
      name="WaterProof"
      description=""
      identifier="ntc_waterproof"

      healableinmedicalclinic="false"
      targets="human"
      limbspecific="true" 
      type="resistance" 
      isbuff="true" 
      
      showinhealthscannerthreshold="999"
      showiconthreshold="0"
      maxstrength="100"

      iconcolors="76,102,145,255;76,102,145,255">

      <icon texture="%ModDir%/Images/AfflictionIcons.png" sheetindex="2,4" sheetelementsize="128,128" origin="0,0" />
    </Affliction>
  </Afflictions>
</Overrides>